# Redis 默认关闭；当前业务会使用 MySQL 和单实例内存降级路径。
TRADEPASS_REDIS_ENABLED=false

# 本地默认使用传统微信接口；生产 profile 默认启用云托管开放接口服务。
WECHAT_CLOUD_OPEN_API_ENABLED=false
# 仅本地使用传统 code2Session/access_token 时需要，生产云调用无需配置。
WECHAT_APP_SECRET=

# 本地开发默认不启用云存储；生产环境通过云调用临时凭证访问微信云托管对象存储。
TRADEPASS_STORAGE_ENABLED=false
TRADEPASS_STORAGE_REQUIRED=false
TRADEPASS_STORAGE_MIGRATE_LEGACY_BLOBS=false
CLOUDBASE_STORAGE_BUCKET=7072-prod-d7g9zrn5s7e6aab68-1446724178
CLOUDBASE_STORAGE_REGION=ap-shanghai
TRADEPASS_STORAGE_KEY_PREFIX=prod
