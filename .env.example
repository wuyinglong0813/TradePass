# 仅复制变量名到本机 .env；不要提交真实 AccessKey。
TRADEPASS_OSS_ENABLED=true
TRADEPASS_OSS_REQUIRED=false
TRADEPASS_OSS_MIGRATE_LEGACY_BLOBS=false
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=sqt-tradepass
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# AES256 无需额外 KMS 权限；如需阿里云 KMS，请改为 KMS 并配置可选密钥 ID。
OSS_SERVER_SIDE_ENCRYPTION=AES256
OSS_KMS_KEY_ID=
OSS_SECURITY_TOKEN=
TRADEPASS_OSS_KEY_PREFIX=prod
