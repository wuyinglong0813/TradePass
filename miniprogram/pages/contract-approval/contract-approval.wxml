<view class="approval-page">
  <view class="approval-hero">
    <image class="hero-mark" src="/images/brand-logo.svg" mode="aspectFit"/>
    <view class="hero-title">待审批</view>
    <view class="hero-desc">合同与履约资料集中处理</view>
  </view>

  <view class="current-company">
    <image src="/images/icons/company.svg" mode="aspectFit"/>
    <view class="company-context">
      <view class="company-context-name">{{currentCompanyName}}</view>
      <view class="company-context-desc">仅展示当前企业收到的待审批事项</view>
    </view>
    <view class="current-badge">当前企业</view>
  </view>

  <view class="approval-tabs">
    <view class="approval-tab {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">
      <text>{{item.label}}</text><text class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <view class="company-filter" wx:if="{{companyOptions.length > 1}}">
    <picker mode="selector" range="{{companyOptions}}" range-key="name" value="{{companyIndex}}" bindchange="selectCompany">
      <view class="company-picker">
        <view><view class="picker-label">按往来公司筛选</view><view class="picker-value">{{companyOptions[companyIndex].name}}</view></view>
        <view class="picker-arrow">⌄</view>
      </view>
    </picker>
  </view>

  <view class="loading-hint" wx:if="{{loading}}">待审批事项加载中...</view>
  <view class="empty-hint" wx:elif="{{visibleGroups.length === 0}}">
    <image src="/images/icons/approval.svg" mode="aspectFit"/>
    <view class="empty-title">{{activeTab === 'CONTRACT' ? '暂无待审批合同' : '暂无待审批履约资料'}}</view>
  </view>

  <view class="approval-groups" wx:else>
    <view class="company-group" wx:for="{{visibleGroups}}" wx:key="companyId" wx:for-item="group">
      <view class="group-head">
        <view class="group-avatar">{{group.initial}}</view>
        <view class="group-copy"><view class="group-name">{{group.companyName}}</view><view class="group-count">{{group.items.length}} 项待处理</view></view>
      </view>

      <block wx:if="{{activeTab === 'CONTRACT'}}">
        <view class="approval-card" wx:for="{{group.items}}" wx:key="id" wx:for-item="contract">
          <view class="card-top">
            <view class="type-icon contract">合</view>
            <view class="card-copy">
              <view class="card-title">{{contract.name}}</view>
              <view class="card-meta">{{contract.contractNo}} · {{contract.createdDate}}</view>
            </view>
            <view class="pending-badge">待签署</view>
          </view>
          <view class="contract-summary">
            <view><text>合同金额</text><view class="summary-strong">¥{{contract.amountText}}</view></view>
            <view><text>合同期限</text><view class="summary-strong">{{contract.startDate || '—'}} 至 {{contract.endDate || '—'}}</view></view>
          </view>
          <view class="card-actions">
            <button class="action ghost" data-contract="{{contract}}" catchtap="viewContract">查看合同</button>
            <button class="action reject" data-contract="{{contract}}" catchtap="reject">拒绝</button>
            <button class="action primary" data-contract="{{contract}}" catchtap="approve">同意签署</button>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="approval-card fulfillment-card" wx:for="{{group.items}}" wx:key="id" wx:for-item="document">
          <view class="card-top">
            <view class="type-icon {{document.typeClass}}">{{document.iconText}}</view>
            <view class="card-copy">
              <view class="card-title">{{document.typeText}} · {{document.documentNo}}</view>
              <view class="card-meta">关联合同：{{document.contractName || document.contractNo}}</view>
              <view class="card-meta"><text wx:if="{{document.dateText}}">{{document.dateText}}</text><text wx:if="{{document.amountText}}"> · ¥{{document.amountText}}</text></view>
              <view class="signature-hint" wx:if="{{document.approvalType === 'SALES_ORDER'}}">确认时需要手写签名</view>
            </view>
            <view class="pending-badge">待确认</view>
          </view>
          <view class="card-actions single" wx:if="{{document.approvalType === 'SALES_ORDER'}}">
            <button class="action primary" data-item="{{document}}" catchtap="openFulfillment">查看并确认</button>
          </view>
          <view class="card-actions" wx:else>
            <button class="action ghost" data-item="{{document}}" catchtap="viewAttachment">查看资料</button>
            <button class="action reject" data-item="{{document}}" catchtap="rejectAttachment">驳回</button>
            <button class="action primary" data-item="{{document}}" catchtap="approveAttachment">确认通过</button>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
