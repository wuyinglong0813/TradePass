page { background: #f4f8fd; }
.approval-page { min-height: 100vh; padding-bottom: 44rpx; }
.approval-hero { background: linear-gradient(138deg,#45a8ff,#2478df 76%,#1557a8); color: #fff; overflow: hidden; padding: 34rpx 30rpx 72rpx; position: relative; }
.hero-mark { height: 210rpx; opacity: .08; position: absolute; right: -26rpx; top: -48rpx; width: 210rpx; }
.hero-title { font-size: 38rpx; font-weight: 700; position: relative; }
.hero-desc { color: rgba(255,255,255,.76); font-size: 22rpx; margin-top: 8rpx; position: relative; }
.current-company { align-items: center; background: #fff; border: 1rpx solid #dce8f5; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(30,70,115,.07); display: flex; margin: -44rpx 24rpx 0; padding: 22rpx; position: relative; }
.current-company image { height: 54rpx; margin-right: 15rpx; width: 54rpx; }
.company-context { flex: 1; min-width: 0; }
.company-context-name { color: #1c3047; font-size: 25rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.company-context-desc { color: #94a0ae; font-size: 19rpx; margin-top: 5rpx; }
.current-badge { background: #eaf4ff; border-radius: 18rpx; color: #2785df; flex-shrink: 0; font-size: 19rpx; margin-left: 12rpx; padding: 6rpx 12rpx; }
.approval-tabs { background: #e8eff7; border-radius: 19rpx; display: grid; gap: 7rpx; grid-template-columns: 1fr 1fr; margin: 22rpx 24rpx 0; padding: 7rpx; }
.approval-tab { align-items: center; border-radius: 15rpx; color: #768493; display: flex; font-size: 23rpx; justify-content: center; padding: 18rpx 10rpx; }
.approval-tab.active { background: #fff; box-shadow: 0 4rpx 14rpx rgba(39,73,112,.09); color: #2185e8; font-weight: 700; }
.tab-count { background: #dfe7f0; border-radius: 15rpx; font-size: 19rpx; margin-left: 8rpx; min-width: 28rpx; padding: 2rpx 7rpx; text-align: center; }
.approval-tab.active .tab-count { background: #e6f3ff; }
.company-filter { margin: 18rpx 24rpx 0; }
.company-picker { align-items: center; background: #fff; border: 1rpx solid #dfe8f3; border-radius: 20rpx; display: flex; padding: 19rpx 22rpx; }
.picker-label { color: #96a1ae; font-size: 19rpx; }
.picker-value { color: #2d4057; font-size: 24rpx; margin-top: 4rpx; }
.picker-arrow { color: #7d8c9c; font-size: 28rpx; margin-left: auto; }
.approval-groups { margin: 0 24rpx; }
.company-group { margin-top: 24rpx; }
.group-head { align-items: center; display: flex; margin: 0 4rpx 12rpx; }
.group-avatar { align-items: center; background: #eaf4ff; border: 1rpx solid #d1e6fb; border-radius: 15rpx; color: #2487e4; display: flex; flex-shrink: 0; font-size: 25rpx; font-weight: 700; height: 58rpx; justify-content: center; width: 58rpx; }
.group-copy { margin-left: 13rpx; min-width: 0; }
.group-name { color: #25394f; font-size: 25rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.group-count { color: #9aa5b1; font-size: 19rpx; margin-top: 3rpx; }
.approval-card { background: #fff; border: 1rpx solid #e1eaf4; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx rgba(28,60,96,.045); margin-bottom: 16rpx; padding: 23rpx; }
.card-top { align-items: flex-start; display: flex; }
.type-icon { align-items: center; background: #eaf4ff; border-radius: 15rpx; color: #2487e4; display: flex; flex-shrink: 0; font-size: 25rpx; font-weight: 700; height: 58rpx; justify-content: center; width: 58rpx; }
.type-icon.payment_voucher { background: #fff4dc; color: #b87415; }
.type-icon.invoice { background: #eaf4ff; color: #2787df; }
.type-icon.sales_order { background: #edf8f2; color: #289465; }
.card-copy { flex: 1; margin-left: 14rpx; min-width: 0; }
.card-title { color: #20344b; font-size: 26rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { color: #929eac; font-size: 20rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.signature-hint { color: #b26e13; font-size: 19rpx; margin-top: 7rpx; }
.pending-badge { background: #fff3d8; border-radius: 16rpx; color: #a36a11; flex-shrink: 0; font-size: 19rpx; margin-left: 10rpx; padding: 5rpx 10rpx; }
.contract-summary { background: #f7faff; border-radius: 16rpx; display: grid; gap: 16rpx; grid-template-columns: .8fr 1.2fr; margin-top: 18rpx; padding: 16rpx; }
.contract-summary text { color: #96a1ad; display: block; font-size: 18rpx; }
.summary-strong { color: #35485d; font-size: 21rpx; font-weight: 600; margin-top: 5rpx; }
.card-actions { border-top: 1rpx solid #edf2f7; display: flex; gap: 10rpx; justify-content: flex-end; margin-top: 18rpx; padding-top: 17rpx; }
.card-actions.single .action { min-width: 190rpx; }
.action { border: 0; border-radius: 15rpx; font-size: 21rpx; height: 64rpx; line-height: 64rpx; margin: 0; padding: 0 18rpx; }
.action::after { border: 0; }
.action.ghost { background: #eff6fd; color: #357fc4; }
.action.reject { background: #f4f6f9; color: #788592; }
.action.primary { background: #2f91ee; color: #fff; }
.loading-hint { color: #8f9ba8; font-size: 23rpx; padding: 70rpx 0; text-align: center; }
.empty-hint { align-items: center; display: flex; flex-direction: column; padding: 90rpx 24rpx; }
.empty-hint image { height: 104rpx; opacity: .75; width: 104rpx; }
.empty-title { color: #7e8b98; font-size: 24rpx; margin-top: 18rpx; }
