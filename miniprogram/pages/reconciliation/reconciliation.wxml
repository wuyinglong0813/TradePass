<view class="recon-page">
  <view class="recon-hero">
    <image src="/images/brand-logo.svg" mode="aspectFit"/>
    <view class="hero-label">{{isGlobal ? '跨企业对账文件中心' : '双方对账文件'}}</view>
    <view class="hero-title">{{isGlobal ? pageTitle + '中心' : '与 ' + counterpartyName + ' 的' + pageTitle}}</view>
    <view class="hero-date">仅支持 Excel .xlsx 原始对账单，可直接查看和下载</view>
  </view>

  <view class="upload-card" wx:if="{{!isGlobal}}">
    <view class="upload-copy">
      <view class="upload-title">上传客户对账单</view>
      <view class="upload-sub">双方均可查看历史文件，上传记录永久保留</view>
    </view>
    <picker mode="date" fields="month" value="{{statementPeriod}}" bindchange="onPeriodChange">
      <view class="period-picker">{{statementPeriod}} ▾</view>
    </picker>
    <button class="upload-button" loading="{{uploading}}" disabled="{{uploading}}" bindtap="chooseStatement">选择 .xlsx</button>
  </view>

  <view class="statement-card">
    <view class="section-head"><view><view class="section-title">历史对账单</view><view class="section-sub">{{isGlobal ? '当前企业参与的全部对账文件' : '按对账月份倒序排列'}}</view></view><view class="count-pill">{{statements.length}}</view></view>
    <view class="statement-list" wx:if="{{statements.length > 0}}">
      <view class="statement-item" wx:for="{{statements}}" wx:key="id">
        <view class="xlsx-icon">X</view>
        <view class="statement-copy">
          <view class="statement-name">{{item.originalName}}</view>
          <view class="statement-meta">{{item.statementPeriod}} · {{item.issuerCompanyName}} · {{item.fileSizeText}}</view>
          <view class="statement-meta">{{item.dateText}}<text wx:if="{{isGlobal}}"> · {{item.counterpartyName}}</text></view>
        </view>
        <view class="statement-actions"><view data-statement="{{item}}" bindtap="viewStatement">查看</view><view data-statement="{{item}}" bindtap="downloadStatement">下载</view></view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && statements.length === 0}}"><view class="empty-icon">表</view><view class="empty-title">暂无 Excel 对账单</view><view class="empty-sub">{{isGlobal ? '从具体合作企业进入后可上传' : '选择月份并上传 .xlsx 文件'}}</view></view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
  </view>
</view>
