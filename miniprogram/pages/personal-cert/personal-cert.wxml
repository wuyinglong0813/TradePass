<view class="page">
  <view class="hero {{statusView.tone}}">
    <view class="hero-mark">
      <view class="hero-icon" wx:if="{{identity && identity.status === 'VERIFIED'}}">✓</view>
      <view class="hero-icon" wx:elif="{{identity && identity.status === 'FAILED'}}">!</view>
      <view class="hero-icon" wx:else>人</view>
    </view>
    <view class="hero-copy">
      <view class="hero-title">{{statusView.title}}</view>
      <view class="hero-desc">{{statusView.desc}}</view>
    </view>
  </view>

  <view class="loading-card" wx:if="{{loading}}">正在加载认证状态...</view>

  <block wx:else>
    <view class="config-notice" wx:if="{{!providerEnabled}}">
      <view class="notice-title">法大大服务尚未启用</view>
      <view class="notice-desc">完成后端应用参数和回调地址配置后，即可发起真实认证。</view>
    </view>

    <view class="info-card">
      <view class="card-title">认证信息</view>
      <view class="info-row">
        <text class="info-label">认证服务</text><text class="info-value">法大大</text>
      </view>
      <view class="info-row">
        <text class="info-label">认证状态</text><text class="status-pill {{statusView.tone}}">{{identity.statusText}}</text>
      </view>
      <view class="info-row" wx:if="{{identity.verifiedName}}">
        <text class="info-label">认证姓名</text><text class="info-value">{{identity.verifiedName}}</text>
      </view>
      <view class="info-row" wx:if="{{identity.identMethod}}">
        <text class="info-label">认证方式</text><text class="info-value">{{identity.identMethod}}</text>
      </view>
      <view class="info-row" wx:if="{{identity.verifiedAt}}">
        <text class="info-label">通过时间</text><text class="info-value minor">{{identity.verifiedAt}}</text>
      </view>
      <view class="failure-box" wx:if="{{identity.failureReason}}">{{identity.failureReason}}</view>
    </view>

    <view class="privacy-card">
      <view class="privacy-icon">盾</view>
      <view class="privacy-copy">
        <view class="privacy-title">敏感信息由法大大认证</view>
        <view class="privacy-desc">身份证号、人脸信息等在法大大认证页面提交，商签通不保存完整证件号或人脸照片。</view>
      </view>
    </view>

    <view class="actions">
      <button class="primary-button" wx:if="{{statusView.button}}" bindtap="startAuth">{{statusView.button}}</button>
      <button class="secondary-button" loading="{{syncing}}" disabled="{{syncing || !providerEnabled}}" bindtap="refreshStatus">刷新认证结果</button>
    </view>
  </block>
</view>
